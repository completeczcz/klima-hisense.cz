---
import '@fontsource-variable/red-hat-display';
import '@fontsource-variable/red-hat-text';
import '../styles/global.css';
import { site } from '../data/site';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';

interface Crumb { name: string; href: string }
interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  noindex?: boolean;
  schema?: Record<string, unknown>[];
  crumbs?: Crumb[];
  hideStickyCta?: boolean;
}
const { title, description, ogType = 'website', noindex = false, schema = [], crumbs = [], hideStickyCta = false } = Astro.props;
const canonical = Astro.props.canonical ?? new URL(Astro.url.pathname, site.url).href;
const fullTitle = `${title} | ${site.name}`.length > 62 ? title : `${title} | ${site.name}`;
const ogImage = new URL(Astro.props.ogImage ?? '/og.jpg', site.url).href;

const orgSchema = {
  '@context': 'https://schema.org',
  '@type': 'HVACBusiness',
  '@id': `${site.url}/#firma`,
  name: `${site.name} – ${site.company.name}`,
  url: site.url,
  telephone: site.phone,
  email: site.email,
  image: ogImage,
  logo: new URL('/img/logo-hisense.png', site.url).href,
  address: { '@type': 'PostalAddress', streetAddress: 'Vyskočilova 1410/1', postalCode: '140 00', addressLocality: 'Praha 4', addressCountry: 'CZ' },
  areaServed: { '@type': 'Country', name: 'Česká republika' },
  brand: { '@type': 'Brand', name: 'Hisense' },
  parentOrganization: { '@type': 'Organization', name: site.company.name, identifier: site.company.ico, vatID: site.company.dic, url: site.company.web, address: { '@type': 'PostalAddress', streetAddress: 'Legerova 1853/24', postalCode: '120 00', addressLocality: 'Praha 2', addressCountry: 'CZ' } },
  openingHoursSpecification: { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '16:00' },
};
const crumbSchema = crumbs.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: [{ name: 'Úvod', href: '/' }, ...crumbs].map((c, i) => ({ '@type': 'ListItem', position: i + 1, name: c.name, item: new URL(c.href, site.url).href })),
    }
  : null;
const allSchema = [orgSchema, ...(crumbSchema ? [crumbSchema] : []), ...schema];
const { gtmId, ga4Id, adsId } = site.analytics;
---
<!doctype html>
<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="theme-color" content="#00a6a2" />
    <script is:inline>document.documentElement.classList.add('js');if(matchMedia('(prefers-reduced-motion: reduce)').matches)document.documentElement.classList.add('reduce');</script>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={ogType} />
    <meta property="og:locale" content="cs_CZ" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    {allSchema.map((s) => <script type="application/ld+json" set:html={JSON.stringify(s)} />)}

    <!-- Google Consent Mode v2: výchozí stav = vše zamítnuto, dokud návštěvník nesouhlasí -->
    <script is:inline define:vars={{ gtmId, ga4Id, adsId }}>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      window.gtag = gtag;
      var saved = null;
      try { saved = JSON.parse(localStorage.getItem('kh-consent') || 'null'); } catch (e) {}
      gtag('consent', 'default', {
        ad_storage: 'denied', ad_user_data: 'denied', ad_personalization: 'denied',
        analytics_storage: 'denied', functionality_storage: 'granted', security_storage: 'granted',
        wait_for_update: 500
      });
      if (saved) {
        gtag('consent', 'update', {
          analytics_storage: saved.analytics ? 'granted' : 'denied',
          ad_storage: saved.marketing ? 'granted' : 'denied',
          ad_user_data: saved.marketing ? 'granted' : 'denied',
          ad_personalization: saved.marketing ? 'granted' : 'denied'
        });
      }
      gtag('set', 'url_passthrough', true);
      gtag('set', 'ads_data_redaction', true);
      try {
        var q = new URLSearchParams(location.search);
        ['gclid','gbraid','wbraid','utm_source','utm_medium','utm_campaign','utm_term','utm_content'].forEach(function (k) {
          if (q.get(k)) sessionStorage.setItem('kh-' + k, q.get(k));
        });
        if (!sessionStorage.getItem('kh-landing')) sessionStorage.setItem('kh-landing', location.pathname);
      } catch (e) {}
      if (gtmId) {
        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer',gtmId);
      } else if (ga4Id || adsId) {
        var s = document.createElement('script'); s.async = true;
        s.src = 'https://www.googletagmanager.com/gtag/js?id=' + (ga4Id || adsId);
        document.head.appendChild(s);
        gtag('js', new Date());
        if (ga4Id) gtag('config', ga4Id);
        if (adsId) gtag('config', adsId);
      }
    </script>
  </head>
  <body>
    <a class="skip" href="#obsah">Přeskočit na obsah</a>
    <Header />
    <main id="obsah">
      {crumbs.length > 0 && (
        <nav class="crumbs wrap" aria-label="Drobečková navigace">
          <a href="/">Úvod</a>
          {crumbs.map((c, i) => (
            <>
              <span aria-hidden="true">/</span>
              {i === crumbs.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.href}>{c.name}</a>}
            </>
          ))}
        </nav>
      )}
      <slot />
    </main>
    <Footer />
    {!hideStickyCta && (
      <div class="sticky-cta" aria-label="Rychlý kontakt">
        <a class="btn btn--ghost" href={site.phoneHref}>Zavolat</a>
        <a class="btn" href="/poptavka/">Nezávazná poptávka</a>
      </div>
    )}
    <CookieBanner />
    <script is:inline>
      (function () {
        var els = document.querySelectorAll('[data-reveal]');
        if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('is-in'); }); return; }
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
        }, { rootMargin: '0px 0px -8% 0px' });
        els.forEach(function (e) { io.observe(e); });
        setTimeout(function () { els.forEach(function (e) { e.classList.add('is-in'); }); }, 2500);
      })();
      (function () {
        var bar = document.querySelector('.sticky-cta');
        var forms = document.querySelectorAll('.lead-form, .cta-band');
        if (!bar || !forms.length || !('IntersectionObserver' in window)) return;
        var vis = new Set();
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { e.isIntersecting ? vis.add(e.target) : vis.delete(e.target); });
          bar.classList.toggle('is-off', vis.size > 0);
        }, { threshold: 0.1 });
        forms.forEach(function (f) { io.observe(f); });
      })();
      document.addEventListener('click', function (e) {
        var a = e.target.closest && e.target.closest('a[href^="tel:"], a[href^="mailto:"]');
        if (a && window.gtag) gtag('event', a.href.indexOf('tel:') === 0 ? 'phone_click' : 'email_click');
      });
    </script>
  </body>
</html>

<style>
  .crumbs { display: flex; flex-wrap: wrap; gap: 0.5em; padding-top: 18px; font-size: var(--step--1); color: var(--ink-2); }
  .crumbs a { color: var(--ink-2); text-decoration: none; }
  .crumbs a:hover { color: var(--teal-ink); text-decoration: underline; }
  .sticky-cta { display: none; }
  @media (max-width: 760px) {
    .sticky-cta {
      position: fixed; z-index: 40; left: 0; right: 0; bottom: 0; display: grid; grid-template-columns: 1fr 2fr; gap: 10px;
      padding: 10px max(16px, env(safe-area-inset-right)) calc(10px + env(safe-area-inset-bottom)) max(16px, env(safe-area-inset-left));
      background: rgba(255, 255, 255, 0.96); border-top: 1px solid var(--line); backdrop-filter: blur(8px); transition: transform 0.25s;
    }
    .sticky-cta .btn { min-height: 46px; padding-inline: 0.8em; }
    .sticky-cta.is-off { transform: translateY(110%); }
    :global(body) { padding-bottom: 72px; }
  }
</style>
