---
import { site } from '../data/site';
interface Props { heading?: string; text?: string }
const { heading = 'Chcete klimatizaci Hisense včetně montáže?', text = `Napište nám, co potřebujete. Ozveme se ${site.responseTime}, doporučíme vhodnou řadu a výkon a montáž zajistí prověřený partner z vašeho regionu.` } = Astro.props;
---
<section class="cta-band">
  <div class="wrap cta-band__in" data-reveal>
    <div>
      <h2>{heading}</h2>
      <p>{text}</p>
    </div>
    <div class="cta-band__btns">
      <a class="btn btn--white" href="/poptavka/">Nezávazná poptávka</a>
      <a class="cta-band__tel" href={site.phoneHref}>nebo volejte {site.phone}</a>
    </div>
  </div>
</section>

<style>
  .cta-band { background: radial-gradient(120% 140% at 100% 0%, #1fc4bf 0%, var(--teal) 40%, var(--teal-dark) 100%); color: #fff; }
  .cta-band__in { display: grid; grid-template-columns: minmax(0, 1.5fr) auto; gap: 24px 48px; align-items: center; padding-block: clamp(44px, 6vw, 72px); }
  .cta-band h2 { color: #fff; font-size: var(--step-3); }
  .cta-band p { margin: 0; color: #e2f7f6; max-width: 60ch; font-size: var(--step-1); }
  .cta-band__btns { display: grid; gap: 10px; justify-items: center; }
  .cta-band__tel { color: #fff; font: 600 0.98rem var(--f-display); }
  @media (max-width: 760px) { .cta-band__in { grid-template-columns: 1fr; } .cta-band__btns { justify-items: start; } }
</style>
