---
import { site, nav } from '../data/site';
import { series } from '../data/products';
import { uses } from '../data/uses';
const helpLinks = [
  { href: '/#pruvodce', label: 'Průvodce výběrem' },
  { href: '/klimatizace/#srovnani', label: 'Srovnání řad' },
  { href: '/vytapeni-klimatizaci/', label: 'Vytápění klimatizací' },
  { href: '/slovnik-pojmu/', label: 'Slovník pojmů' },
  { href: '/montaz-klimatizace/', label: 'Montáž v krajích' },
];
const path = Astro.url.pathname;
const active = nav.filter((n) => path.startsWith(n.href)).sort((a, b) => b.href.length - a.href.length)[0]?.href;
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href="/" aria-label="Klima Hisense – úvod">
      <img src="/img/logo-hisense.png" alt="Hisense" width="145" height="24" />
      <span class="hdr__sub">Klimatizace s montáží<br />Oficiální zastoupení pro ČR</span>
    </a>
    <nav class="hdr__nav" aria-label="Hlavní navigace">
      {nav.map((n) => n.href === '/klimatizace/' ? (
        <div class="dd">
          <a href={n.href} aria-current={n.href === active ? 'page' : undefined}>{n.label}</a>
          <button class="dd__btn" type="button" aria-expanded="false" aria-controls="dd-klima" aria-label="Rozbalit nabídku Klimatizace"><svg viewBox="0 0 12 8" width="12" height="8" aria-hidden="true"><path d="M1 1.5l5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg></button>
          <div class="dd__panel" id="dd-klima">
            <div>
              <p class="dd__h">Podle použití</p>
              <ul>
                {uses.map((u) => <li><a href={`/klimatizace/${u.slug}/`}>{u.label}</a></li>)}
                <li><a href="/klimatizace/multisplit/">Více místností – multisplit</a></li>
              </ul>
            </div>
            <div>
              <p class="dd__h">Řady Hisense</p>
              <ul>
                {series.map((s) => <li><a href={`/klimatizace/${s.id}/`}>{s.name}<span>{s.tagline}</span></a></li>)}
              </ul>
            </div>
            <div>
              <p class="dd__h">Poradíme</p>
              <ul>{helpLinks.map((l) => <li><a href={l.href}>{l.label}</a></li>)}</ul>
              <a class="btn btn--sm dd__cta" href="/klimatizace/">Všechny klimatizace</a>
            </div>
          </div>
        </div>
      ) : <a href={n.href} aria-current={n.href === active ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="hdr__tel" href={site.phoneHref}>{site.phone}</a>
    <a class="btn btn--sm hdr__cta" href="/poptavka/">Poptávka</a>
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Otevřít menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mnav" id="mnav" hidden>
    <div class="wrap">
      <p class="mnav__h">Podle použití</p>
      <ul class="mnav__uses">
        {uses.map((u) => <li><a href={`/klimatizace/${u.slug}/`}>{u.label}</a></li>)}
        <li><a href="/vytapeni-klimatizaci/">Na topení</a></li>
        <li><a href="/#pruvodce">Průvodce výběrem</a></li>
      </ul>
      <p class="mnav__h">Klimatizace Hisense</p>
      <ul class="mnav__series">
        {series.map((s) => <li><a href={`/klimatizace/${s.id}/`}>{s.name}<span>{s.tagline}</span></a></li>)}
        <li><a class="mnav__multi" href="/klimatizace/multisplit/">Multisplit<span>2–5 místností, jedna venkovní jednotka</span></a></li>
      </ul>
      <ul class="mnav__links">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
      <div class="mnav__cta">
        <a class="btn btn--block" href="/poptavka/">Nezávazná poptávka</a>
        <a class="btn btn--ghost btn--block" href={site.phoneHref}>Zavolat {site.phone}</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var b = document.querySelector('.hdr__burger'), m = document.getElementById('mnav');
    if (!b || !m) return;
    function set(open) {
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      b.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      m.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    }
    b.addEventListener('click', function () { set(b.getAttribute('aria-expanded') !== 'true'); });
    m.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
    addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    addEventListener('resize', function () { if (innerWidth > 1024) set(false); });
  })();
  (function () {
    var dd = document.querySelector('.dd'); if (!dd) return;
    var btn = dd.querySelector('.dd__btn');
    function open(v) { dd.classList.toggle('is-open', v); btn.setAttribute('aria-expanded', v ? 'true' : 'false'); }
    btn.addEventListener('click', function (e) { e.stopPropagation(); open(!dd.classList.contains('is-open')); });
    document.addEventListener('click', function (e) { if (!dd.contains(e.target)) open(false); });
    dd.addEventListener('keydown', function (e) { if (e.key === 'Escape') { open(false); btn.focus(); } });
  })();
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.97); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top); }
  .hdr__in { display: flex; align-items: center; gap: 22px; min-height: 70px; }
  .hdr__brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .hdr__brand img { height: 24px; width: auto; }
  .hdr__sub { font-size: 0.72rem; line-height: 1.3; color: var(--ink-2); border-left: 1px solid var(--line); padding-left: 12px; }
  .hdr__nav { display: flex; align-items: center; gap: 22px; margin-left: auto; font: 500 0.96rem var(--f-display); white-space: nowrap; }
  .hdr__nav a { color: var(--ink); text-decoration: none; padding: 6px 0; border-bottom: 2px solid transparent; }
  .hdr__nav a:hover, .hdr__nav a[aria-current] { color: var(--teal-ink); border-color: var(--teal); }
  .dd { position: relative; display: flex; align-items: center; gap: 2px; }
  .dd__btn { display: grid; place-items: center; width: 26px; height: 32px; border: 0; background: none; color: var(--ink-2); cursor: pointer; border-radius: 6px; }
  .dd__btn:hover { color: var(--teal-ink); background: var(--teal-tint); }
  .dd__btn svg { transition: transform 0.2s; }
  .dd.is-open .dd__btn svg { transform: rotate(180deg); }
  .dd__panel { position: absolute; top: calc(100% + 18px); left: -24px; z-index: 60; width: min(760px, calc(100vw - 40px)); display: grid; grid-template-columns: 1fr 1.25fr 1fr; gap: 24px; background: #fff; border: 1px solid var(--line); border-radius: var(--r-l); box-shadow: 0 24px 50px -24px rgba(0, 50, 60, 0.4); padding: 24px; opacity: 0; visibility: hidden; transform: translateY(6px); transition: opacity 0.18s, transform 0.18s, visibility 0.18s; }
  .dd__panel::before { content: ''; position: absolute; left: 0; right: 0; top: -20px; height: 20px; }
  .dd:hover .dd__panel, .dd:focus-within .dd__panel, .dd.is-open .dd__panel { opacity: 1; visibility: visible; transform: none; }
  .dd__h { font: 700 0.72rem var(--f-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal-ink); margin: 0 0 8px; }
  .dd__panel ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 2px; }
  .hdr__nav .dd__panel a { display: block; border: 0; padding: 6px 8px; margin: 0 -8px; border-radius: 8px; font: 600 0.95rem var(--f-display); color: var(--ink); }
  .hdr__nav .dd__panel a:hover { background: var(--teal-tint); color: var(--teal-ink); }
  .dd__panel a span { display: block; font: 400 0.78rem var(--f-body); color: var(--ink-2); }
  .hdr__nav .dd__panel .dd__cta { display: inline-flex; margin: 14px 0 0; color: #fff; padding: 0.5em 1.05em; }
  .hdr__nav .dd__panel .dd__cta:hover { color: #fff; background: var(--teal-ink); }
  .hdr__tel { font: 700 0.95rem var(--f-display); color: var(--ink); text-decoration: none; white-space: nowrap; }
  .hdr__tel:hover { color: var(--teal-ink); }
  .hdr__burger { display: none; width: 46px; height: 46px; border: 1px solid var(--line); border-radius: 12px; background: #fff; cursor: pointer; padding: 0 12px; flex-direction: column; justify-content: center; gap: 5px; }
  .hdr__burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .hdr__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hdr__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mnav { border-top: 1px solid var(--line); background: #fff; max-height: calc(100dvh - 70px); overflow-y: auto; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
  .mnav__h { font: 700 0.76rem var(--f-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal-ink); margin: 20px 0 8px; }
  .mnav ul { list-style: none; margin: 0; padding: 0; }
  .mnav__series { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .mnav__series a { display: grid; gap: 2px; text-decoration: none; background: var(--teal-tint); border-radius: 10px; padding: 12px 14px; font: 700 1rem var(--f-display); color: var(--ink); }
  .mnav__series .mnav__multi { background: var(--teal-soft); border: 1px solid var(--teal); }
  .mnav__series span { font: 400 0.8rem var(--f-body); color: var(--ink-2); }
  .mnav__uses { display: flex; flex-wrap: wrap; gap: 8px; }
  .mnav__uses a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; border: 1px solid var(--teal); border-radius: 999px; text-decoration: none; color: var(--teal-ink); font: 600 0.95rem var(--f-display); }
  .mnav__links { margin-top: 14px !important; border-top: 1px solid var(--line); }
  .mnav__links a { display: block; padding: 14px 2px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); font: 600 1.05rem var(--f-display); }
  .mnav__cta { display: grid; gap: 10px; margin-top: 20px; }

  @media (max-width: 1280px) { .hdr__tel { display: none; } }
  @media (max-width: 1120px) { .hdr__nav { gap: 16px; font-size: 0.92rem; } .hdr__sub { display: none; } }
  @media (max-width: 1024px) {
    .hdr__nav { display: none; }
    .hdr__cta { margin-left: auto; }
    .hdr__burger { display: flex; }
  }
  @media (max-width: 520px) {
    .hdr__sub { display: none; }
    .hdr__in { gap: 10px; min-height: 64px; }
    .mnav__series { grid-template-columns: 1fr; }
  }
  @media (min-width: 1025px) { .mnav { display: none !important; } }
  :global(html.menu-open) { overflow: hidden; }
</style>
