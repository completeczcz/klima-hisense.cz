---
import { site, nav } from '../data/site';
import { series } from '../data/products';
const path = Astro.url.pathname;
const active = nav.filter((n) => path.startsWith(n.href)).sort((a, b) => b.href.length - a.href.length)[0]?.href;
---
<header class="hdr">
  <div class="wrap hdr__in">
    <a class="hdr__brand" href="/" aria-label="Klima Hisense – úvod">
      <img src="/img/logo-hisense.png" alt="Hisense" width="145" height="24" />
      <span class="hdr__sub">Klimatizace s montáží<br />Oficiální zastoupení pro ČR</span>
    </a>
    <nav class="hdr__nav" aria-label="Hlavní navigace">
      {nav.map((n) => <a href={n.href} aria-current={n.href === active ? 'page' : undefined}>{n.label}</a>)}
    </nav>
    <a class="hdr__tel" href={site.phoneHref}>{site.phone}</a>
    <a class="btn btn--sm hdr__cta" href="/poptavka/">Poptávka</a>
    <button class="hdr__burger" type="button" aria-expanded="false" aria-controls="mnav" aria-label="Otevřít menu">
      <span></span><span></span><span></span>
    </button>
  </div>
  <div class="mnav" id="mnav" hidden>
    <div class="wrap">
      <p class="mnav__h">Klimatizace Hisense</p>
      <ul class="mnav__series">
        {series.map((s) => <li><a href={`/klimatizace/${s.id}/`}>{s.name}<span>{s.tagline}</span></a></li>)}
        <li><a class="mnav__multi" href="/klimatizace/multisplit/">Multisplit<span>2–5 místností, jedna venkovní jednotka</span></a></li>
      </ul>
      <ul class="mnav__links">
        {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
        <li><a href="/kontakt/">Kontakt</a></li>
      </ul>
      <div class="mnav__cta">
        <a class="btn btn--block" href="/poptavka/">Nezávazná poptávka</a>
        <a class="btn btn--ghost btn--block" href={site.phoneHref}>Zavolat {site.phone}</a>
      </div>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var b = document.querySelector('.hdr__burger'), m = document.getElementById('mnav');
    if (!b || !m) return;
    function set(open) {
      b.setAttribute('aria-expanded', open ? 'true' : 'false');
      b.setAttribute('aria-label', open ? 'Zavřít menu' : 'Otevřít menu');
      m.hidden = !open;
      document.documentElement.classList.toggle('menu-open', open);
    }
    b.addEventListener('click', function () { set(b.getAttribute('aria-expanded') !== 'true'); });
    m.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
    addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
    addEventListener('resize', function () { if (innerWidth > 1024) set(false); });
  })();
</script>

<style>
  .hdr { position: sticky; top: 0; z-index: 50; background: rgba(255, 255, 255, 0.97); backdrop-filter: blur(10px); border-bottom: 1px solid var(--line); padding-top: env(safe-area-inset-top); }
  .hdr__in { display: flex; align-items: center; gap: 22px; min-height: 70px; }
  .hdr__brand { display: flex; align-items: center; gap: 12px; text-decoration: none; flex: none; }
  .hdr__brand img { height: 24px; width: auto; }
  .hdr__sub { font-size: 0.72rem; line-height: 1.3; color: var(--ink-2); border-left: 1px solid var(--line); padding-left: 12px; }
  .hdr__nav { display: flex; gap: 24px; margin-left: auto; font: 500 0.96rem var(--f-display); }
  .hdr__nav a { color: var(--ink); text-decoration: none; padding: 6px 0; border-bottom: 2px solid transparent; }
  .hdr__nav a:hover, .hdr__nav a[aria-current] { color: var(--teal-ink); border-color: var(--teal); }
  .hdr__tel { font: 700 0.95rem var(--f-display); color: var(--ink); text-decoration: none; white-space: nowrap; }
  .hdr__tel:hover { color: var(--teal-ink); }
  .hdr__burger { display: none; width: 46px; height: 46px; border: 1px solid var(--line); border-radius: 12px; background: #fff; cursor: pointer; padding: 0 12px; flex-direction: column; justify-content: center; gap: 5px; }
  .hdr__burger span { display: block; height: 2px; background: var(--ink); border-radius: 2px; transition: transform 0.2s, opacity 0.2s; }
  .hdr__burger[aria-expanded='true'] span:nth-child(1) { transform: translateY(7px) rotate(45deg); }
  .hdr__burger[aria-expanded='true'] span:nth-child(2) { opacity: 0; }
  .hdr__burger[aria-expanded='true'] span:nth-child(3) { transform: translateY(-7px) rotate(-45deg); }

  .mnav { border-top: 1px solid var(--line); background: #fff; max-height: calc(100dvh - 70px); overflow-y: auto; padding-bottom: calc(24px + env(safe-area-inset-bottom)); }
  .mnav__h { font: 700 0.76rem var(--f-display); letter-spacing: 0.14em; text-transform: uppercase; color: var(--teal-ink); margin: 20px 0 8px; }
  .mnav ul { list-style: none; margin: 0; padding: 0; }
  .mnav__series { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 8px; }
  .mnav__series a { display: grid; gap: 2px; text-decoration: none; background: var(--teal-tint); border-radius: 10px; padding: 12px 14px; font: 700 1rem var(--f-display); color: var(--ink); }
  .mnav__series .mnav__multi { background: var(--teal-soft); border: 1px solid var(--teal); }
  .mnav__series span { font: 400 0.8rem var(--f-body); color: var(--ink-2); }
  .mnav__links { margin-top: 14px !important; border-top: 1px solid var(--line); }
  .mnav__links a { display: block; padding: 14px 2px; border-bottom: 1px solid var(--line); text-decoration: none; color: var(--ink); font: 600 1.05rem var(--f-display); }
  .mnav__cta { display: grid; gap: 10px; margin-top: 20px; }

  @media (max-width: 1180px) { .hdr__tel { display: none; } }
  @media (max-width: 1024px) {
    .hdr__nav { display: none; }
    .hdr__cta { margin-left: auto; }
    .hdr__burger { display: flex; }
  }
  @media (max-width: 520px) {
    .hdr__sub { display: none; }
    .hdr__in { gap: 10px; min-height: 64px; }
    .mnav__series { grid-template-columns: 1fr; }
  }
  @media (min-width: 1025px) { .mnav { display: none !important; } }
  :global(html.menu-open) { overflow: hidden; }
</style>
