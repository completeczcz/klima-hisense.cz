---
import { type Series, useLabels, mainImage } from '../data/products';
import { featureById } from '../data/features';
interface Props { s: Series; headingLevel?: 'h2' | 'h3' }
const { s, headingLevel = 'h3' } = Astro.props;
const H = headingLevel;
const icons = s.functions.slice(0, 5).map(featureById);
const useSlug: Record<string, string> = { byt: 'do-bytu', dum: 'do-domu', loznice: 'do-loznice', kancelar: 'do-kancelare' };
---
<article class="sc" data-uses={s.uses.join(' ')} data-reveal>
  <a class="sc__stage" href={`/klimatizace/${s.id}/`} aria-label={`Hisense ${s.name} – detail`}>
    <span class="tag">{s.tag}</span>
    <img src={mainImage(s)} alt={`Klimatizace Hisense ${s.name}`} loading="lazy" width="900" height="330" />
  </a>
  <div class="sc__body">
    <H class="sc__name"><a href={`/klimatizace/${s.id}/`}>{s.name}</a></H>
    <p class="sc__tagline">{s.tagline}</p>
    <ul class="sc__hl">{s.highlights.map((h) => <li>{h}</li>)}</ul>
    <dl class="sc__stats">
      {s.stats.map((st) => <div><dt>{st.label}</dt><dd class="num">{st.value}</dd></div>)}
    </dl>
    <div class="sc__icons" aria-label="Vybrané funkce">
      {icons.map((f) => <img src={f.icon} alt={f.name} title={f.name} width="44" height="44" loading="lazy" />)}
    </div>
    <p class="sc__uses">{s.uses.map((u) => <a class="chip" href={`/klimatizace/${useSlug[u]}/`}>{useLabels[u]}</a>)}</p>
    <div class="sc__cta">
      <a class="btn btn--sm" href={`/klimatizace/${s.id}/`}>Prohlédnout</a>
      <a class="btn btn--sm btn--ghost" href={`/poptavka/?rada=${s.id}`}>Poptat</a>
    </div>
  </div>
</article>

<style>
  .sc { display: flex; flex-direction: column; background: #fff; border: 1px solid var(--line); border-radius: var(--r-l); overflow: hidden; transition: box-shadow 0.3s, transform 0.3s; }
  .sc:hover { box-shadow: var(--shadow); transform: translateY(-4px); }
  .sc[hidden] { display: none; }
  .sc__stage { position: relative; display: grid; place-items: center; height: 200px; padding: 40px 26px 22px; background: radial-gradient(120% 100% at 50% 0%, #fff 30%, var(--teal-tint)); border-bottom: 1px solid var(--line); overflow: hidden; }
  .sc__stage .tag { position: absolute; top: 14px; left: 14px; }
  .sc__stage img { max-height: 120px; width: auto; object-fit: contain; filter: drop-shadow(0 16px 18px rgba(0, 40, 50, 0.16)); transition: transform 0.4s; }
  .sc:hover .sc__stage img { transform: scale(1.04); }
  .sc__body { display: flex; flex-direction: column; gap: 12px; padding: 22px 22px 24px; flex: 1; }
  .sc__name { font-size: 1.5rem; margin: 0; }
  .sc__name a { color: var(--ink); text-decoration: none; }
  .sc__tagline { color: var(--teal-ink); font: 600 0.98rem var(--f-display); margin: -6px 0 0; }
  .sc__hl { list-style: none; margin: 0; padding: 0; display: grid; gap: 5px; font-size: 0.94rem; color: var(--ink-2); }
  .sc__hl li { display: flex; gap: 9px; }
  .sc__hl li::before { content: ''; flex: none; width: 7px; height: 7px; margin-top: 0.6em; border-radius: 50%; background: var(--teal); }
  .sc__stats { display: grid; grid-template-columns: repeat(3, 1fr); margin: 4px 0 0; border: 1px solid var(--line); border-radius: 10px; overflow: hidden; }
  .sc__stats div { padding: 8px 10px; text-align: center; }
  .sc__stats div + div { border-left: 1px solid var(--line); }
  .sc__stats dt { font-size: 0.68rem; color: var(--ink-3); text-transform: uppercase; letter-spacing: 0.06em; line-height: 1.3; }
  .sc__stats dd { margin: 2px 0 0; font: 800 1rem var(--f-display); color: var(--ink); white-space: nowrap; }
  .sc__icons { display: flex; gap: 8px; flex-wrap: wrap; }
  .sc__icons img { width: 40px; height: 40px; object-fit: contain; }
  .sc__uses .chip { text-decoration: none; }
  .sc__uses .chip:hover { background: var(--teal); color: #fff; }
  .sc__uses { display: flex; flex-wrap: wrap; gap: 6px; margin: 0; }
  .sc__cta { margin-top: auto; padding-top: 6px; display: flex; gap: 10px; flex-wrap: wrap; }
</style>
