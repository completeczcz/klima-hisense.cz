---
import Base from '../layouts/Base.astro';
import Faq from '../components/Faq.astro';
import { site } from '../data/site';
const kraje = ['Praha', 'Středočeský', 'Jihočeský', 'Plzeňský', 'Karlovarský', 'Ústecký', 'Liberecký', 'Královéhradecký', 'Pardubický', 'Vysočina', 'Jihomoravský', 'Olomoucký', 'Zlínský', 'Moravskoslezský'];
const faq = [
  { q: 'Kdo se může stát partnerem?', a: 'Montážní firmy a živnostníci, kteří montují klimatizace, mají oprávnění pro práci s chladivy (F-plyny) a chtějí nabízet klimatizace Hisense svým zákazníkům.' },
  { q: 'Musím mít sklad nebo showroom?', a: 'Nemusíte. Zařízení dodáváme jako oficiální zastoupení Hisense pro ČR, vy se staráte o obhlídku, montáž a servis u zákazníka.' },
  { q: 'Jak rychle se ozvete?', a: `Ozveme se ${site.responseTime} a domluvíme si krátký hovor nebo schůzku.` },
];
---
<Base
  title="Staňte se partnerem Hisense – pro montážní firmy"
  description="Montujete klimatizace? Staňte se partnerem Hisense: dodávky od oficiálního zastoupení pro ČR, technická podpora, náhradní díly a poptávky od zákazníků z vašeho regionu."
  crumbs={[{ name: 'Pro montážní firmy', href: '/pro-montazni-firmy/' }]}
>
  <section class="section pf-hero">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Pro montážní firmy</span>
        <h1>Staňte se partnerem Hisense</h1>
        <p class="lead">Montujete klimatizace? Nabídněte zákazníkům chytré klimatizace Hisense s podporou oficiálního zastoupení pro Českou republiku.</p>
        <div class="btns"><a class="btn" href="#formular">Mám zájem o spolupráci</a><a class="btn btn--ghost" href={site.phoneHref}>Zavolat {site.phone}</a></div>
      </div>
      <div class="photo pf-photo"><img src="/img/kancelar.jpg" alt="Kancelář s klimatizací Hisense" width="1200" height="900" fetchpriority="high" /></div>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap">
      <div class="head">
        <span class="eyebrow">Co získáte</span>
        <h2>Proč spolupracovat s námi</h2>
      </div>
      <div class="grid grid--3">
        <div class="card pf-b" data-reveal><h3>Dodávky od oficiálního zastoupení</h3><p>Originální zařízení Hisense přímo od {site.company.name}, oficiálního zastoupení Hisense pro ČR.</p></div>
        <div class="card pf-b" data-reveal><h3>Poptávky z vašeho regionu</h3><p>Poptávky koncových zákazníků z webu klima-hisense.cz předáváme prověřeným partnerům v regionu.</p></div>
        <div class="card pf-b" data-reveal><h3>Technická podpora a díly</h3><p>Pomoc s technickými dotazy a náhradní díly dodáváme přímo jako zastoupení výrobce.</p></div>
        <div class="card pf-b" data-reveal><h3>Celé portfolio Hisense</h3><p>Nástěnné řady od Hi‑Smart po Air Master, multisplity pro 2–5 místností a jednotky pro kanceláře.</p></div>
        <div class="card pf-b" data-reveal><h3>Podklady pro prodej</h3><p>Katalogy, technické listy a informace, se kterými zákazníkovi snadno vysvětlíte rozdíly mezi řadami.</p></div>
        <div class="card pf-b" data-reveal><h3>Záruka 3 roky</h3><p>Na všechny klimatizace Hisense, které od nás dodáváte.</p></div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap split split--top">
      <div>
        <span class="eyebrow">Jak to probíhá</span>
        <h2>Tři kroky ke spolupráci</h2>
        <ol class="pf-steps">
          <li><b>Vyplníte formulář</b><span>Stačí základní údaje o firmě a kraje, kde montujete.</span></li>
          <li><b>Ozveme se vám</b><span>Do jednoho pracovního dne se domluvíme na podmínkách spolupráce.</span></li>
          <li><b>Začnete nabízet Hisense</b><span>Objednáváte zařízení a podle regionu můžete dostávat i poptávky z webu.</span></li>
        </ol>
        <div class="pf-req">
          <h3>Koho hledáme</h3>
          <ul class="ticks">
            <li>Montážní firmy a živnostníky s praxí v montáži klimatizací</li>
            <li>Oprávnění pro práci s chladivy (F-plyny)</li>
            <li>Kvalitní a čistou práci a férový přístup k zákazníkům</li>
          </ul>
        </div>
      </div>

      <form class="pf-form" id="formular" novalidate>
        <h2 class="pf-form__h">Mám zájem o spolupráci</h2>
        <div class="field full"><label for="pf-firma">Název firmy *</label><input id="pf-firma" name="firma" autocomplete="organization" required /></div>
        <div class="field"><label for="pf-ico">IČO</label><input id="pf-ico" name="ico" inputmode="numeric" maxlength="8" /></div>
        <div class="field"><label for="pf-jmeno">Kontaktní osoba *</label><input id="pf-jmeno" name="jmeno" autocomplete="name" required /></div>
        <div class="field"><label for="pf-telefon">Telefon *</label><input id="pf-telefon" name="telefon" type="tel" autocomplete="tel" placeholder="+420" required /></div>
        <div class="field"><label for="pf-email">E‑mail *</label><input id="pf-email" name="email" type="email" autocomplete="email" required /></div>
        <fieldset class="full pf-fs">
          <legend class="legend">Kde montujete?</legend>
          <div class="pf-chips">{kraje.map((k, i) => <><input type="checkbox" name="kraje" id={`pf-k${i}`} value={k} /><label for={`pf-k${i}`}>{k}</label></>)}</div>
        </fieldset>
        <fieldset class="full pf-fs">
          <legend class="legend">Máte certifikaci pro práci s F-plyny?</legend>
          <div class="pf-chips"><input type="radio" name="fplyny" id="pf-f1" value="ano" /><label for="pf-f1">Ano</label><input type="radio" name="fplyny" id="pf-f2" value="ne" /><label for="pf-f2">Ne</label></div>
        </fieldset>
        <div class="field full"><label for="pf-pozn">Zpráva</label><textarea id="pf-pozn" name="poznamka" placeholder="Např. kolik montáží ročně děláte, s jakými značkami pracujete…"></textarea></div>
        <div class="pf-hp" aria-hidden="true"><label for="pf-web">Web</label><input id="pf-web" name="web" tabindex="-1" autocomplete="off" /></div>
        <label class="pf-check full"><input type="checkbox" name="souhlas" value="ano" required /> <span>Souhlasím se <a href="/ochrana-osobnich-udaju/" target="_blank">zpracováním osobních údajů</a> za účelem domluvy spolupráce.</span></label>
        <p class="pf-err full" role="alert" hidden></p>
        <p class="pf-ok full" role="status" hidden>Děkujeme, máme to. Ozveme se vám {site.responseTime}.</p>
        <div class="full"><button class="btn btn--block" type="submit">Odeslat</button></div>
      </form>
    </div>
  </section>

  <section class="section section--alt">
    <div class="wrap"><Faq items={faq} /></div>
  </section>
</Base>

<script is:inline>
  (function () {
    var f = document.querySelector('.pf-form'); if (!f) return;
    var err = f.querySelector('.pf-err'), ok = f.querySelector('.pf-ok'), btn = f.querySelector('button[type=submit]');
    var msg = { povinne: 'Vyplňte prosím název firmy a kontaktní osobu.', ico: 'IČO má 8 číslic.', telefon: 'Zkontrolujte telefonní číslo.', email: 'Zkontrolujte e‑mail.', souhlas: 'Potvrďte prosím souhlas se zpracováním údajů.', limit: 'Formulář jste už odeslali. Zkuste to prosím později nebo zavolejte.' };
    f.addEventListener('submit', function (e) {
      e.preventDefault();
      var v = '';
      if (!f.firma.value.trim() || !f.jmeno.value.trim()) v = 'povinne';
      else if (f.ico.value.trim() && !/^\d{8}$/.test(f.ico.value.replace(/\s/g, ''))) v = 'ico';
      else if (!/^\+?[\d\s]{9,17}$/.test(f.telefon.value.trim())) v = 'telefon';
      else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(f.email.value.trim())) v = 'email';
      else if (!f.souhlas.checked) v = 'souhlas';
      if (v) { err.textContent = msg[v]; err.hidden = false; return; }
      err.hidden = true; btn.disabled = true; btn.textContent = 'Odesílám…';
      var data = { kraje: [] };
      new FormData(f).forEach(function (val, k) { if (k === 'kraje') data.kraje.push(val); else data[k] = val; });
      fetch('/api/partner', { method: 'POST', headers: { 'Content-Type': 'application/json', Accept: 'application/json' }, body: JSON.stringify(data) })
        .then(function (r) { return r.json().catch(function () { return { ok: false }; }); })
        .then(function (out) {
          if (out.ok) {
            ok.hidden = false; btn.textContent = 'Odesláno';
            if (window.gtag) gtag('event', 'partner_lead');
            return;
          }
          err.textContent = msg[out.error] || 'Formulář se nepodařilo odeslat. Zkuste to prosím znovu nebo zavolejte.'; err.hidden = false;
          btn.disabled = false; btn.textContent = 'Odeslat';
        })
        .catch(function () { err.textContent = 'Formulář se nepodařilo odeslat. Zkontrolujte připojení nebo zavolejte.'; err.hidden = false; btn.disabled = false; btn.textContent = 'Odeslat'; });
    });
  })();
</script>

<style>
  .pf-hero { padding-top: 28px; }
  .pf-photo { aspect-ratio: 4 / 3; }
  .pf-b { padding: 22px; }
  .pf-b h3 { font-size: 1.08rem; }
  .pf-b p { margin: 0; color: var(--ink-2); font-size: 0.94rem; }
  .split--top { align-items: start; }
  .pf-steps { list-style: none; counter-reset: s; margin: 0 0 28px; padding: 0; display: grid; gap: 14px; }
  .pf-steps li { counter-increment: s; display: grid; grid-template-columns: 40px 1fr; gap: 2px 14px; }
  .pf-steps li::before { content: counter(s); grid-row: span 2; width: 40px; height: 40px; border-radius: 50%; background: var(--teal); color: #fff; display: grid; place-items: center; font: 800 1.05rem var(--f-display); }
  .pf-steps b { font-family: var(--f-display); }
  .pf-steps span { color: var(--ink-2); font-size: 0.95rem; }
  .pf-req h3 { margin-bottom: 0.6em; }
  .pf-form { background: #fff; border: 1px solid var(--line); border-radius: var(--r-l); box-shadow: var(--shadow); padding: clamp(20px, 3vw, 32px); display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; scroll-margin-top: 90px; }
  .pf-form .full { grid-column: 1 / -1; }
  .pf-form__h { grid-column: 1 / -1; font-size: var(--step-2); margin: 0; }
  .pf-fs { border: 0; margin: 0; padding: 0; }
  .pf-chips { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 8px; }
  .pf-chips input { position: absolute; opacity: 0; pointer-events: none; }
  .pf-chips label { display: inline-flex; align-items: center; min-height: 40px; border: 1px solid #c9d7da; border-radius: 999px; padding: 0.4em 0.95em; font-size: 0.9rem; cursor: pointer; }
  .pf-chips input:checked + label { background: var(--teal); border-color: var(--teal); color: #fff; }
  .pf-chips input:focus-visible + label { outline: 3px solid var(--teal); outline-offset: 2px; }
  .pf-hp { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .pf-check { display: flex; gap: 10px; align-items: flex-start; font-size: 0.88rem; color: var(--ink-2); }
  .pf-check input { width: 20px; height: 20px; margin-top: 2px; accent-color: var(--teal); flex: none; }
  .pf-err { color: var(--err); font-weight: 600; margin: 0; }
  .pf-ok { color: var(--ok); font-weight: 700; margin: 0; background: #e8f6ee; border-radius: 10px; padding: 12px 14px; }
  @media (max-width: 600px) { .pf-form { grid-template-columns: 1fr; } }
</style>
